# Orchestrator, audio frontend and TUI (CPU)
ARG BASE_IMAGE=dustynv/pytorch:r36.4.0
FROM ${BASE_IMAGE}

# uv is a single static binary, so it leaves the base image's Python alone.
# Pin the tag rather than using latest (§12: no unverified version bumps).
COPY --from=ghcr.io/astral-sh/uv:0.12 /uv /uvx /bin/

# PortAudio and libsndfile come from apt; a pip/uv wheel does not cover these.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libportaudio2 portaudio19-dev libsndfile1 alsa-utils \
    && rm -rf /var/lib/apt/lists/*

# Install into the container's system Python. A project venv from uv sync would
# shadow the CUDA torch build that ships in the base image.
ENV UV_SYSTEM_PYTHON=1 \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Runtime dependencies come from the lockfile, pinned. Copy these before the
# source so the layer is reused when only code changes.
COPY pyproject.toml uv.lock README.md LICENSE hatch_build.py ./
RUN uv export --frozen --no-dev --no-emit-project --no-hashes -o /tmp/req.txt \
 && uv pip install --no-cache -r /tmp/req.txt

COPY src ./src
RUN uv pip install --no-cache --no-deps -e .

# aarch64 support for onnxruntime (VAD) and deepfilternet (denoise) is verified
# by measurement in Phase 0. A failure here does not stop the build; the runtime
# falls back. These stay outside the lockfile because their aarch64 resolution
# differs from the development machine, so locking them breaks the device.
RUN (uv pip install --no-cache onnxruntime || echo "!! onnxruntime failed — VAD falls back") \
 && (uv pip install --no-cache deepfilternet || echo "!! deepfilternet failed — no denoise")

# Check whether the installs above replaced the base image's CUDA torch with a
# PyPI CPU build. Silently clobbered, that would only surface on the device.
RUN python3 -c "import torch; print('torch', torch.__version__, 'cuda', torch.version.cuda)" \
    || echo "!! could not check torch"

CMD ["python3", "-m", "kotonoha._cli", "run"]
