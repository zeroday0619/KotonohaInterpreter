# TranslateGemma service on the NVIDIA multi-platform vLLM runtime.
ARG BASE_IMAGE=nvcr.io/nvidia/vllm:26.07-py3
FROM ${BASE_IMAGE}
ENTRYPOINT []

COPY --from=ghcr.io/astral-sh/uv:0.12 /uv /uvx /bin/

ENV UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/models/hf

# Keep the vendor CUDA, PyTorch, and vLLM packages visible while installing the
# application and its locked runtime dependencies in one environment.
RUN uv venv --python python3 --system-site-packages /opt/kotonoha-venv
ENV VIRTUAL_ENV=/opt/kotonoha-venv \
    UV_PYTHON=/opt/kotonoha-venv/bin/python \
    PATH=/opt/kotonoha-venv/bin:${PATH}

WORKDIR /app
COPY pyproject.toml uv.lock README.md LICENSE hatch_build.py ./
RUN uv sync --active --frozen --no-dev --no-install-project --no-cache

COPY src ./src
RUN uv sync --active --frozen --no-dev --no-cache \
 && uv pip check --python "$UV_PYTHON" \
 && "$UV_PYTHON" -c \
 "from importlib.metadata import version; from importlib.util import find_spec; from pathlib import Path; import kotonoha, numpy, websockets; assert Path(numpy.__file__).is_relative_to('/opt/kotonoha-venv'), numpy.__file__; assert version('vllm').split('+', 1)[0] == '0.24.0', version('vllm'); spec = find_spec('vllm'); assert spec and spec.submodule_search_locations, 'vLLM package missing'; root = Path(next(iter(spec.submodule_search_locations))); assert list(root.rglob('api_server.py')), 'vLLM async engine builder missing'; print('TranslateGemma service dependencies ok | NumPy', numpy.__version__, '| vLLM', version('vllm'))"

# PyTorch probes NVML from torch.cuda.device_count() after vLLM starts its worker.
# The CUDA 13.3 image exercises native NVML by default. The shadow-library fallback
# remains available for reproductions of the previous nvmlInit() crash.
ARG NVML_BYPASS=0
RUN mkdir -p /opt/kotonoha/nvml-bypass \
 && if [ "$NVML_BYPASS" = "1" ]; then \
      printf 'kotonoha: not a loadable ELF object\n' \
        > /opt/kotonoha/nvml-bypass/libnvidia-ml.so.1; \
    fi
ENV LD_LIBRARY_PATH=/opt/kotonoha/nvml-bypass:${LD_LIBRARY_PATH}

EXPOSE 8003
CMD ["uvicorn", "kotonoha.services._llm_server:app", "--host", "0.0.0.0", "--port", "8003", "--loop", "uvloop"]
