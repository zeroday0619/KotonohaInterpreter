# Services running on the external RTX A6000 box (x86_64, sm_86).
#
# The constraints in §2 are Jetson constraints and do not apply here: this is
# ordinary x86 CUDA, so vLLM, flash-attn and the usual wheels are eligible.
# Role-specific targets share the application layer but produce distinct images.
#
# Pin BASE_IMAGE to a verified tag that is present on the deployment host.
ARG BASE_IMAGE=pytorch/pytorch:2.6.0-cuda12.6-cudnn9-runtime
ARG ASR_BASE_IMAGE=nvcr.io/nvidia/vllm:26.07-py3
ARG LLM_BASE_IMAGE=nvcr.io/nvidia/vllm:26.07-py3
FROM ${BASE_IMAGE} AS common

COPY --from=ghcr.io/astral-sh/uv:0.12 /uv /uvx /bin/

RUN apt-get update && apt-get install -y --no-install-recommends \
        libsndfile1 ffmpeg git \
    && rm -rf /var/lib/apt/lists/*

ENV UV_PYTHON=/opt/conda/bin/python \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/models/hf

WORKDIR /app
COPY pyproject.toml uv.lock README.md LICENSE hatch_build.py ./
RUN uv export --frozen --no-dev --no-emit-project --no-hashes -o /tmp/req.txt \
 && uv pip install --python "$UV_PYTHON" --no-cache -r /tmp/req.txt

COPY src ./src
RUN uv pip install --python "$UV_PYTHON" --no-cache --no-deps -e . \
 && python3 -c "import kotonoha, pydantic_settings; print('application dependencies ok')"

FROM common AS metrics
CMD ["python3", "-m", "kotonoha.services._metrics_server"]

FROM ${ASR_BASE_IMAGE} AS asr
ENTRYPOINT []
COPY --from=ghcr.io/astral-sh/uv:0.12 /uv /uvx /bin/
RUN apt-get update && apt-get install -y --no-install-recommends libsndfile1 patch \
    && rm -rf /var/lib/apt/lists/*
ENV UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/models/hf
RUN uv venv --python python3 --system-site-packages /opt/kotonoha-venv
ENV VIRTUAL_ENV=/opt/kotonoha-venv \
    UV_PYTHON=/opt/kotonoha-venv/bin/python \
    PATH=/opt/kotonoha-venv/bin:${PATH}
WORKDIR /app
COPY pyproject.toml uv.lock README.md LICENSE hatch_build.py ./
RUN uv sync --active --frozen --no-dev --extra a6000-asr \
      --no-install-project --no-cache
COPY src ./src
# NVIDIA vLLM 0.24.0 returns only audio embeddings when an offline Voxtral
# prefill contains both audio placeholders and its trailing text token. Align
# those embeddings to the scheduler's multimodal mask before starting vLLM's
# N-best beam search. Remove this pinned patch when the base image includes the
# upstream correction.
COPY docker/patches/vllm-0.24.0-voxtral-mixed-prefill.patch /tmp/
RUN voxtral_module=$("$UV_PYTHON" -c \
 "from importlib.util import find_spec; from pathlib import Path; spec = find_spec('vllm'); assert spec and spec.submodule_search_locations; root = Path(next(iter(spec.submodule_search_locations))); matches = list(root.rglob('voxtral_realtime.py')); assert len(matches) == 1, matches; print(matches[0])") \
 && patch --batch --forward "$voxtral_module" \
      /tmp/vllm-0.24.0-voxtral-mixed-prefill.patch \
 && "$UV_PYTHON" -m py_compile "$voxtral_module" \
 && grep -Fq "mixed_embeddings[is_multimodal] = mm_embeds_flat" "$voxtral_module"
# BuildKit has no GPU runtime. Verify module presence without importing vLLM;
# deployment performs the CUDA-aware import after Compose attaches the GPU.
RUN uv sync --active --frozen --no-dev --extra a6000-asr \
      --reinstall-package nvidia-cufft --reinstall-package nvidia-nvjitlink --no-cache \
 && uv pip check --python "$UV_PYTHON" \
 && "$UV_PYTHON" -c \
 "import kotonoha, mistral_common, numpy, scipy, sklearn, soundfile, soxr; from importlib.util import find_spec; from pathlib import Path; from transformers import GenerationMixin; numpy_release = tuple(map(int, numpy.__version__.split('.')[:2])); assert (2, 0) <= numpy_release < (2, 3), numpy.__version__; assert Path(numpy.__file__).is_relative_to('/opt/kotonoha-venv'), numpy.__file__; spec = find_spec('vllm'); assert spec and spec.submodule_search_locations, 'vLLM package missing'; root = Path(next(iter(spec.submodule_search_locations))); realtime = list(root.rglob('voxtral_realtime.py')); connection = list(root.rglob('realtime/connection.py')); assert realtime, 'Voxtral realtime module missing'; assert connection, 'vLLM realtime connection missing'; print('ASR dependencies ok | NumPy', numpy.__version__, '| SciPy', scipy.__version__, '| Voxtral module', realtime[0], '| realtime connection', connection[0])"
# NVIDIA inference images intentionally ship a cuFFT stub. Voxtral executes a
# CUDA STFT while building its mel spectrogram, so expose the full locked
# nvidia-cufft library before the image's stub directory.
RUN cufft_library_directory=$("$UV_PYTHON" -c \
 "from importlib.metadata import distribution; from pathlib import Path; root = Path(distribution('nvidia-cufft').locate_file('')); libraries = list(root.glob('nvidia/**/lib/libcufft.so.12')); assert len(libraries) == 1, libraries; library = libraries[0]; runtime_libraries = (library, library.parent / 'libnvJitLink.so.13'); assert all(path.is_file() and path.stat().st_size > 1048576 for path in runtime_libraries), f'CUDA stub or missing runtime library: {runtime_libraries}'; print(library.parent)") \
 && ln -s "$cufft_library_directory" /opt/kotonoha-cufft
ENV LD_LIBRARY_PATH=/opt/kotonoha-cufft:${LD_LIBRARY_PATH}
CMD ["uvicorn", "kotonoha.services._asr_server:app", "--host", "0.0.0.0", "--port", "8001", "--loop", "uvloop"]

FROM ${LLM_BASE_IMAGE} AS llm
ENTRYPOINT []
COPY --from=ghcr.io/astral-sh/uv:0.12 /uv /uvx /bin/
ENV UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/models/hf
RUN uv venv --python python3 --system-site-packages /opt/kotonoha-venv
ENV VIRTUAL_ENV=/opt/kotonoha-venv \
    UV_PYTHON=/opt/kotonoha-venv/bin/python \
    PATH=/opt/kotonoha-venv/bin:${PATH}
WORKDIR /app
COPY pyproject.toml uv.lock README.md LICENSE hatch_build.py ./
RUN uv sync --active --frozen --no-dev --no-install-project --no-cache
COPY src ./src
RUN uv sync --active --frozen --no-dev --no-cache \
 && uv pip check --python "$UV_PYTHON" \
 && "$UV_PYTHON" -c \
 "from importlib.util import find_spec; from pathlib import Path; import kotonoha, numpy, scipy, sklearn, websockets; from transformers import GenerationMixin; numpy_release = tuple(map(int, numpy.__version__.split('.')[:2])); assert (2, 0) <= numpy_release < (2, 3), numpy.__version__; assert Path(numpy.__file__).is_relative_to('/opt/kotonoha-venv'), numpy.__file__; spec = find_spec('vllm'); assert spec and spec.submodule_search_locations, 'vLLM package missing'; root = Path(next(iter(spec.submodule_search_locations))); assert list(root.rglob('api_server.py')), 'vLLM async engine builder missing'; print('TranslateGemma service dependencies ok | NumPy', numpy.__version__, '| SciPy', scipy.__version__)"
CMD ["uvicorn", "kotonoha.services._llm_server:app", "--host", "0.0.0.0", "--port", "8003", "--loop", "uvloop"]

FROM common AS asr-verify
RUN uv pip install --python "$UV_PYTHON" --no-cache soundfile faster-whisper \
 && python3 -c "import ctranslate2, faster_whisper, pydantic_settings; print('verify dependencies ok')"
CMD ["uvicorn", "kotonoha.services._asr_verify_server:app", "--host", "0.0.0.0", "--port", "8002", "--loop", "uvloop"]
