# Services running on the external RTX A6000 box (x86_64, sm_86).
#
# The constraints in §2 are Jetson constraints and do not apply here: this is
# ordinary x86 CUDA, so vLLM, flash-attn and the usual wheels are eligible.
# Role-specific targets share the application layer but produce distinct images.
#
# Pin BASE_IMAGE to a verified tag that is present on the deployment host.
ARG BASE_IMAGE=pytorch/pytorch:2.6.0-cuda12.6-cudnn9-runtime
ARG TTS_BUILD_IMAGE=pytorch/pytorch:2.6.0-cuda12.6-cudnn9-devel
FROM ${BASE_IMAGE} AS common

COPY --from=ghcr.io/astral-sh/uv:0.12 /uv /uvx /bin/

RUN apt-get update && apt-get install -y --no-install-recommends \
        libsndfile1 ffmpeg git sox libsox-fmt-all \
    && rm -rf /var/lib/apt/lists/*

ENV UV_PYTHON=/opt/conda/bin/python \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/models/hf

WORKDIR /app
COPY pyproject.toml uv.lock README.md LICENSE ./
RUN uv export --frozen --no-dev --no-emit-project --no-hashes -o /tmp/req.txt \
 && uv pip install --python "$UV_PYTHON" --no-cache -r /tmp/req.txt

COPY src ./src
RUN uv pip install --python "$UV_PYTHON" --no-cache --no-deps -e . \
 && python3 -c "import kotonoha, pydantic_settings; print('application dependencies ok')"

FROM common AS asr
RUN uv pip install --python "$UV_PYTHON" --no-cache \
        "transformers>=4.57" accelerate soundfile \
 && python3 -c "import pydantic_settings, torch, transformers; print('asr dependencies ok')"
CMD ["uvicorn", "kotonoha.services.asr_server:app", "--host", "0.0.0.0", "--port", "8001", "--loop", "uvloop"]

FROM common AS asr-verify
RUN uv pip install --python "$UV_PYTHON" --no-cache soundfile faster-whisper \
 && python3 -c "import ctranslate2, faster_whisper, pydantic_settings; print('verify dependencies ok')"
CMD ["uvicorn", "kotonoha.services.asr_verify_server:app", "--host", "0.0.0.0", "--port", "8002", "--loop", "uvloop"]

FROM ${TTS_BUILD_IMAGE} AS tts-flash-builder
COPY --from=ghcr.io/astral-sh/uv:0.12 /uv /uvx /bin/
ENV UV_PYTHON=/opt/conda/bin/python \
    UV_LINK_MODE=copy \
    MAX_JOBS=4 \
    FLASH_ATTENTION_FORCE_BUILD=TRUE
ARG FLASH_ATTN_VERSION=2.8.3.post1

# The runtime image has no nvcc. Building in the matching devel image preserves
# the base image's PyTorch and CUDA ABI while keeping compiler tools out of the
# service image.
RUN uv pip install --python "$UV_PYTHON" --no-cache packaging psutil ninja einops \
 && uv pip install --python "$UV_PYTHON" --no-cache --no-deps \
      --target /opt/flash-attn "flash-attn==${FLASH_ATTN_VERSION}" --no-build-isolation \
 && PYTHONPATH=/opt/flash-attn python3 -c \
      "import flash_attn, flash_attn_2_cuda; print('flash-attn', flash_attn.__version__)"

FROM common AS tts
COPY --from=tts-flash-builder /opt/flash-attn /opt/flash-attn
ENV PYTHONPATH=/opt/flash-attn
ARG QWEN_TTS_VERSION=0.1.1

# Remote Qwen failure is retried against the resident Jetson MeloTTS service.
# Installing both backends here would combine incompatible Transformers pins.
RUN uv pip install --python "$UV_PYTHON" --no-cache \
        "transformers==4.57.3" accelerate soundfile "qwen-tts==${QWEN_TTS_VERSION}" \
 && python3 -c \
      "import flash_attn, pydantic_settings, qwen_tts, sox, torch; \
print('torch', torch.__version__, 'cuda', torch.version.cuda, '| tts dependencies ok')"

CMD ["uvicorn", "kotonoha.services.tts_server:app", "--host", "0.0.0.0", "--port", "8004", "--loop", "uvloop"]
