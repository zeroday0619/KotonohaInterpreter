# Services running on the external RTX A6000 box (x86_64, sm_86).
#
# The constraints in §2 are Jetson constraints and do not apply here: this is
# ordinary x86 CUDA, so vLLM, flash-attn and the usual wheels all work. One
# image serves ASR, verification and TTS; compose picks the role by command.
#
# Pin BASE_IMAGE to a tag you have actually pulled. Do not leave it floating.
ARG BASE_IMAGE=pytorch/pytorch:2.6.0-cuda12.6-cudnn9-runtime
FROM ${BASE_IMAGE}

COPY --from=ghcr.io/astral-sh/uv:0.12 /uv /uvx /bin/

RUN apt-get update && apt-get install -y --no-install-recommends \
        libsndfile1 ffmpeg git \
    && rm -rf /var/lib/apt/lists/*

ENV UV_SYSTEM_PYTHON=1 \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/models/hf

WORKDIR /app
COPY pyproject.toml uv.lock README.md LICENSE ./
RUN uv export --frozen --no-dev --no-emit-project --no-hashes -o /tmp/req.txt \
 && uv pip install --no-cache -r /tmp/req.txt

COPY src ./src
RUN uv pip install --no-cache --no-deps -e .

# Model runtimes. Unlike the Orin images these are not best-effort: if they do
# not install, this box has no reason to exist, so the build should fail.
RUN uv pip install --no-cache \
        "transformers>=4.57" accelerate soundfile faster-whisper

# flash-attn does build for sm_86. It is still slow to compile, so it is kept
# separate and allowed to fail — Qwen3-TTS falls back to sdpa and /health says so.
ARG BUILD_FLASH_ATTN=1
RUN if [ "$BUILD_FLASH_ATTN" = "1" ]; then \
      uv pip install --no-cache flash-attn --no-build-isolation \
      || echo "!! flash-attn failed — Qwen3-TTS will use sdpa"; \
    fi

RUN (uv pip install --no-cache qwen-tts || echo "!! qwen-tts failed — Melo fallback") \
 && (uv pip install --no-cache melotts   || echo "!! melotts failed — no fallback")

RUN python3 -c "import torch; print('torch', torch.__version__, 'cuda', torch.version.cuda, \
'| capability', torch.cuda.get_device_capability(0) if torch.cuda.is_available() else 'no gpu at build time')"

CMD ["uvicorn", "kotonoha.services.asr_server:app", "--host", "0.0.0.0", "--port", "8001"]
