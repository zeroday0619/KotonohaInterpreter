# TTS service layer on the official multi-platform vLLM-Omni runtime.
ARG BASE_IMAGE=vllm/vllm-omni:v0.26.0
FROM ${BASE_IMAGE}
ENTRYPOINT []

COPY --from=ghcr.io/astral-sh/uv:0.12 /uv /uvx /bin/

ENV UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/models/hf

RUN uv venv --python python3 --system-site-packages /opt/kotonoha-venv
ENV VIRTUAL_ENV=/opt/kotonoha-venv \
    UV_PYTHON=/opt/kotonoha-venv/bin/python \
    PATH=/opt/kotonoha-venv/bin:${PATH}

WORKDIR /app
COPY pyproject.toml uv.lock README.md LICENSE hatch_build.py ./
RUN uv sync --active --frozen --no-dev --no-install-project --no-cache

COPY src ./src
RUN uv sync --active --frozen --no-dev --no-cache \
 && uv pip check --python "$UV_PYTHON" \
 && "$UV_PYTHON" -c \
 "from importlib.metadata import version; from pathlib import Path; import fastapi, kotonoha, numpy; numpy_release = tuple(map(int, numpy.__version__.split('.')[:2])); assert (2, 0) <= numpy_release < (2, 3), numpy.__version__; assert 'long' in numpy.__dict__; assert Path(numpy.__file__).is_relative_to('/opt/kotonoha-venv'), numpy.__file__; assert version('vllm').startswith('0.26.'); assert version('vllm-omni').startswith('0.26.'); print('TTS service dependencies ok | NumPy', numpy.__version__)"

# Keep Jetson vLLM-Omni startup on the non-NVML platform path. The same Dockerfile
# serves the A6000 Compose stack, where the native NVML path remains enabled.
ARG JETSON_NVML_PATCH=0
COPY docker/patches/disable_vllm_nvml.py /tmp/disable_vllm_nvml.py
RUN if [ "$JETSON_NVML_PATCH" = "1" ]; then \
      python3 /tmp/disable_vllm_nvml.py; \
    fi \
 && rm /tmp/disable_vllm_nvml.py
ENV KOTONOHA_DISABLE_NVML=0

EXPOSE 8004
CMD ["uvicorn", "kotonoha.services._tts_server:app", "--host", "0.0.0.0", "--port", "8004", "--loop", "uvloop"]
