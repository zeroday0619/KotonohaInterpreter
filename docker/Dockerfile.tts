# TTS — Qwen3-TTS 0.6B with a MeloTTS fallback
# The base contains an sm_87 FlashAttention build. Spike 2 must still execute
# the kernel and Qwen3-TTS because package presence does not verify operation.
ARG BASE_IMAGE=ghcr.io/nvidia-ai-iot/vllm:r36.4.tegra-aarch64-cu126-22.04
FROM ${BASE_IMAGE}
ENTRYPOINT []

COPY --from=ghcr.io/astral-sh/uv:0.12 /uv /uvx /bin/

RUN apt-get update && apt-get install -y --no-install-recommends \
        libsndfile1 sox libsox-fmt-all \
    && rm -rf /var/lib/apt/lists/*

ENV UV_PYTHON=/opt/venv/bin/python \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY pyproject.toml uv.lock README.md LICENSE hatch_build.py ./
RUN uv export --frozen --no-dev --no-emit-project --no-hashes -o /tmp/req.txt \
 && uv pip install --python "$UV_PYTHON" --no-cache -r /tmp/req.txt soundfile

COPY src ./src
RUN uv pip install --python "$UV_PYTHON" --no-cache --no-deps -e .

# Both TTS backends are best-effort; /health reports which one came up.
# They stay outside the lockfile for the same reason as in the orchestrator:
# aarch64 resolves them differently.
RUN (uv pip install --python "$UV_PYTHON" --no-cache qwen-tts \
      || echo "!! qwen-tts failed — starting on the Melo fallback") \
 && (uv pip install --python "$UV_PYTHON" --no-cache melotts \
      || echo "!! melotts failed — no fallback available")

RUN sox --version \
 && "$UV_PYTHON" -c \
      "import soxr, torch; print('soxr', soxr.__version__, 'torch', torch.__version__, 'cuda', torch.version.cuda)"

EXPOSE 8004
CMD ["uvicorn", "kotonoha.services._tts_server:app", "--host", "0.0.0.0", "--port", "8004", "--loop", "uvloop"]
