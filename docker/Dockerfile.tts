# TTS — Qwen3-TTS 0.6B with a MeloTTS fallback
# The Qwen3-TTS model card uses flash_attention_2. Whether that builds for sm_87
# is what Spike 2 asks, so flash-attn is not forced here.
ARG BASE_IMAGE=dustynv/pytorch:r36.4.0
FROM ${BASE_IMAGE}

COPY --from=ghcr.io/astral-sh/uv:0.12 /uv /uvx /bin/

RUN apt-get update && apt-get install -y --no-install-recommends libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

ENV UV_SYSTEM_PYTHON=1 \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY pyproject.toml uv.lock README.md LICENSE ./
RUN uv export --frozen --no-dev --no-emit-project --no-hashes -o /tmp/req.txt \
 && uv pip install --no-cache -r /tmp/req.txt soundfile

COPY src ./src
RUN uv pip install --no-cache --no-deps -e .

# Both TTS backends are best-effort; /health reports which one came up.
# They stay outside the lockfile for the same reason as in the orchestrator:
# aarch64 resolves them differently.
RUN (uv pip install --no-cache qwen-tts || echo "!! qwen-tts failed — starting on the Melo fallback") \
 && (uv pip install --no-cache melotts   || echo "!! melotts failed — no fallback available")

RUN python3 -c "import torch; print('torch', torch.__version__, 'cuda', torch.version.cuda)" \
    || echo "!! could not check torch"

EXPOSE 8004
CMD ["uvicorn", "kotonoha.services._tts_server:app", "--host", "0.0.0.0", "--port", "8004", "--loop", "uvloop"]
