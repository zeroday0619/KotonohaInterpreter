# Docker contract for nvidia.jetson.agx-orin.

ACCELERATOR_PROFILE=nvidia.jetson.agx-orin
CONTAINER_RUNTIME=nvidia
GPU_DRIVER=nvidia
ACCELERATOR_DEVICE_ENV=NVIDIA_VISIBLE_DEVICES
VLLM_NVML_PATCH=1
KOTONOHA_DISABLE_NVML=1
ACCELERATOR_VLLM_IMAGE=nvcr.io/nvidia/vllm:26.07-py3
ACCELERATOR_OMNI_IMAGE=vllm/vllm-omni:v0.26.0
