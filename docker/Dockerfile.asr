# Primary ASR — Qwen3-ASR 0.6B on the NVIDIA multi-platform vLLM runtime.
ARG BASE_IMAGE=nvcr.io/nvidia/vllm:26.07-py3
FROM ${BASE_IMAGE}
ENTRYPOINT []

COPY --from=ghcr.io/astral-sh/uv:0.12 /uv /uvx /bin/

RUN apt-get update && apt-get install -y --no-install-recommends libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

ENV UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/models/hf

# Keep the vendor CUDA, PyTorch, and vLLM packages visible without allowing the
# project dependency set to replace them.
RUN uv venv --python python3 --system-site-packages /opt/kotonoha-venv
ENV VIRTUAL_ENV=/opt/kotonoha-venv \
    UV_PYTHON=/opt/kotonoha-venv/bin/python \
    PATH=/opt/kotonoha-venv/bin:${PATH}

ARG TRANSFORMERS_FALLBACK_VERSION=5.13.0

WORKDIR /app
COPY pyproject.toml uv.lock README.md LICENSE hatch_build.py ./
RUN uv sync --active --frozen --no-dev --no-install-project --no-cache

COPY src ./src
RUN uv sync --active --frozen --no-dev --no-cache \
 && uv pip check --python "$UV_PYTHON"

# The native Hugging Face checkpoint requires Transformers 5.13 or newer,
# while the vendor vLLM runtime owns its Transformers installation. Keep the
# fallback isolated and inherit only the vendor CUDA/PyTorch packages.
RUN uv venv --python python3 --system-site-packages /opt/transformers-fallback \
 && env -u UV_CONSTRAINT -u PIP_CONSTRAINT uv pip install \
      --python /opt/transformers-fallback/bin/python --no-cache \
      "transformers==${TRANSFORMERS_FALLBACK_VERSION}" librosa soundfile \
 && env -u UV_CONSTRAINT -u PIP_CONSTRAINT uv pip install \
      --python /opt/transformers-fallback/bin/python --no-cache --no-deps \
      accelerate==1.12.0 \
 && /opt/transformers-fallback/bin/python -c \
 "import accelerate, torch, transformers; from transformers import AutoModelForMultimodalLM, AutoProcessor; assert transformers.__version__ == '${TRANSFORMERS_FALLBACK_VERSION}', transformers.__version__; assert torch.version.cuda is not None, torch.__file__; print('Transformers fallback dependencies ok', transformers.__version__, torch.__version__, torch.version.cuda)"

ENV SPIKE_TRANSFORMERS_PYTHON=/opt/transformers-fallback/bin/python

# BuildKit has no GPU runtime. Verify module presence without importing vLLM;
# deployment performs the CUDA-aware import after Compose attaches the GPU.
RUN "$UV_PYTHON" -c \
 "from importlib.metadata import version; from importlib.util import find_spec; from pathlib import Path; spec = find_spec('vllm'); assert spec and spec.submodule_search_locations, 'vLLM package missing'; root = Path(next(iter(spec.submodule_search_locations))); batch = list(root.rglob('qwen3_asr.py')); realtime = list(root.rglob('qwen3_asr_realtime.py')); connection = list(root.rglob('realtime/connection.py')); assert version('vllm').split('+', 1)[0] == '0.24.0', version('vllm'); assert batch, 'Qwen3-ASR module missing'; assert realtime, 'Qwen3-ASR realtime module missing'; assert connection, 'vLLM realtime connection missing'; print('Qwen3-ASR modules', batch[0], realtime[0], connection[0])"

# Jetson exposes the nvgpu driver, whose NVML entry point can segfault instead of
# returning an exception. Force vLLM's CUDA platform to use raw CUDA device queries.
ARG VLLM_NVML_PATCH=1
COPY docker/patches/disable_vllm_nvml.py /tmp/disable_vllm_nvml.py
RUN if [ "$VLLM_NVML_PATCH" = "1" ]; then \
      python3 /tmp/disable_vllm_nvml.py; \
    fi \
 && rm /tmp/disable_vllm_nvml.py
ENV KOTONOHA_DISABLE_NVML=0

EXPOSE 8001
CMD ["uvicorn", "kotonoha.services._asr_server:app", "--host", "0.0.0.0", "--port", "8001", "--loop", "uvloop"]
