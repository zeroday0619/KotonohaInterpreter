# Primary ASR — Qwen3-ASR 1.7B on the Jetson vLLM runtime.
ARG BASE_IMAGE=ghcr.io/nvidia-ai-iot/vllm:r36.4-tegra-aarch64-cu126-22.04
FROM ${BASE_IMAGE}

COPY --from=ghcr.io/astral-sh/uv:0.12 /uv /uvx /bin/

RUN apt-get update && apt-get install -y --no-install-recommends libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

ENV UV_SYSTEM_PYTHON=1 \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY pyproject.toml uv.lock README.md LICENSE hatch_build.py ./
RUN uv export --frozen --no-dev --no-emit-project --no-hashes -o /tmp/req.txt \
 && uv pip install --no-cache -r /tmp/req.txt

COPY src ./src
RUN uv pip install --no-cache --no-deps -e .

# The build fails when the selected Jetson image predates native Qwen3-ASR support.
RUN python3 -c \
 "import vllm; from vllm.model_executor.models.qwen3_asr import Qwen3ASRForConditionalGeneration; print('vllm', vllm.__version__, '| Qwen3-ASR available')"

EXPOSE 8001
CMD ["uvicorn", "kotonoha.services._asr_server:app", "--host", "0.0.0.0", "--port", "8001", "--loop", "uvloop"]
