# 1차 ASR — Qwen3-ASR 1.7B (transformers 경로)
# Spike 1 에서 vLLM 이 확인되면 ghcr.io/nvidia-ai-iot/vllm:r36.4-tegra-aarch64-cu126-22.04
# 기반으로 별도 Dockerfile 을 만든다. 확인 전에는 만들지 않는다.
ARG BASE_IMAGE=dustynv/transformers:r36.4.0
FROM ${BASE_IMAGE}

COPY --from=ghcr.io/astral-sh/uv:0.12 /uv /uvx /bin/

RUN apt-get update && apt-get install -y --no-install-recommends libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

ENV UV_SYSTEM_PYTHON=1 \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY pyproject.toml uv.lock README.md LICENSE ./
RUN uv export --frozen --no-dev --no-emit-project --no-hashes -o /tmp/req.txt \
 && uv pip install --no-cache -r /tmp/req.txt

COPY src ./src
RUN uv pip install --no-cache --no-deps -e .

# transformers 는 베이스 이미지가 이미 갖고 있다. 버전이 모자랄 때만 올린다.
# --no-deps 로 torch 가 딸려 올라오는 것을 막는다.
RUN python3 -c "import transformers, sys; sys.exit(0 if tuple(map(int, transformers.__version__.split('.')[:2])) >= (4, 57) else 1)" \
 || uv pip install --no-cache --no-deps "transformers>=4.57"
RUN python3 -c "import torch, transformers; print('torch', torch.__version__, 'cuda', torch.version.cuda, '| transformers', transformers.__version__)"

EXPOSE 8001
CMD ["uvicorn", "kotonoha.services.asr_server:app", "--host", "0.0.0.0", "--port", "8001"]
