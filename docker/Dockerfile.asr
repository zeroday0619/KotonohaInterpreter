# Primary ASR — Qwen3-ASR 1.7B on the selected NVIDIA Tegra runtime.
ARG BASE_IMAGE=ghcr.io/nvidia-ai-iot/vllm:r36.4.tegra-aarch64-cu126-22.04
FROM ${BASE_IMAGE}
ENTRYPOINT []

COPY --from=ghcr.io/astral-sh/uv:0.12 /uv /uvx /bin/

RUN apt-get update && apt-get install -y --no-install-recommends libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

ENV UV_PYTHON=/opt/venv/bin/python \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    PYTHONUNBUFFERED=1

ARG TRANSFORMERS_FALLBACK_VERSION=5.13.0

WORKDIR /app
COPY pyproject.toml uv.lock README.md LICENSE hatch_build.py ./
RUN uv export --frozen --no-dev --no-emit-project --no-hashes -o /tmp/req.txt \
 && uv pip install --python "$UV_PYTHON" --no-cache -r /tmp/req.txt

COPY src ./src
RUN uv pip install --python "$UV_PYTHON" --no-cache --no-deps -e .

# The native Hugging Face checkpoint requires Transformers 5.13 or newer,
# while the vendor vLLM runtime owns its Transformers 4.x installation. Keep
# the fallback isolated and inherit only the vendor CUDA/PyTorch packages.
RUN uv venv --python "$UV_PYTHON" /opt/transformers-fallback \
 && /opt/transformers-fallback/bin/python -c \
 "from pathlib import Path; import site; vendor = next(Path('/opt/venv/lib').glob('python*/site-packages')); Path(site.getsitepackages()[0], 'vendor-vllm.pth').write_text(f'{vendor}\n', encoding='utf-8')" \
 && uv pip install --python /opt/transformers-fallback/bin/python --no-cache \
      "transformers==${TRANSFORMERS_FALLBACK_VERSION}" librosa soundfile \
 && uv pip install --python /opt/transformers-fallback/bin/python --no-cache --no-deps \
      accelerate==1.12.0 \
 && /opt/transformers-fallback/bin/python -c \
 "import accelerate, torch; from transformers import AutoModelForMultimodalLM, AutoProcessor; print('Transformers fallback dependencies ok', torch.__version__)"

ENV SPIKE_TRANSFORMERS_PYTHON=/opt/transformers-fallback/bin/python

# BuildKit has no GPU runtime. Verify module presence without importing vLLM;
# deployment performs the CUDA-aware import after Compose attaches the GPU.
RUN "$UV_PYTHON" -c \
 "from importlib.util import find_spec; from pathlib import Path; spec = find_spec('vllm'); assert spec and spec.submodule_search_locations, 'vLLM package missing'; root = Path(next(iter(spec.submodule_search_locations))); matches = list(root.rglob('qwen3_asr.py')); assert matches, 'Qwen3-ASR module missing'; print('Qwen3-ASR module', matches[0])"

EXPOSE 8001
CMD ["uvicorn", "kotonoha.services._asr_server:app", "--host", "0.0.0.0", "--port", "8001", "--loop", "uvloop"]
