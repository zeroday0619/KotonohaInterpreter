# Cross-verification ASR — faster-whisper large-v3 (CTranslate2).
# The published AArch64 CTranslate2 artifact lacks CUDA support, so the Jetson
# baseline runs this conditional verifier on CPU with INT8 compute.
ARG BASE_IMAGE=nvcr.io/nvidia/vllm:26.07-py3
FROM ${BASE_IMAGE}
ENTRYPOINT []

COPY --from=ghcr.io/astral-sh/uv:0.12 /uv /uvx /bin/

ENV UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN uv venv --python python3 --system-site-packages /opt/kotonoha-venv
ENV VIRTUAL_ENV=/opt/kotonoha-venv \
    UV_PYTHON=/opt/kotonoha-venv/bin/python \
    PATH=/opt/kotonoha-venv/bin:${PATH}

WORKDIR /app
COPY pyproject.toml uv.lock README.md LICENSE hatch_build.py ./
RUN uv sync --active --frozen --no-dev --extra asr-verify \
      --no-install-project --no-cache

COPY src ./src
RUN uv sync --active --frozen --no-dev --extra asr-verify --no-cache \
 && uv pip check --python "$UV_PYTHON"

# A CPU-only wheel imports successfully, so verify the compute capability used
# by the Jetson configuration instead of treating an import as sufficient.
RUN "$UV_PYTHON" -c \
 "import ctranslate2, faster_whisper; compute_types = ctranslate2.get_supported_compute_types('cpu'); assert 'int8' in compute_types, compute_types; print('ct2', ctranslate2.__version__, '| fw', faster_whisper.__version__, '| cpu', compute_types)"

# Keep vLLM's CUDA platform on the Jetson-safe non-NVML path when this image
# imports the vendor runtime during service startup.
ARG VLLM_NVML_PATCH=1
COPY docker/patches/disable_vllm_nvml.py /tmp/disable_vllm_nvml.py
RUN if [ "$VLLM_NVML_PATCH" = "1" ]; then \
      python3 /tmp/disable_vllm_nvml.py; \
    fi \
 && rm /tmp/disable_vllm_nvml.py
ENV KOTONOHA_DISABLE_NVML=0

EXPOSE 8002
CMD ["uvicorn", "kotonoha.services._asr_verify_server:app", "--host", "0.0.0.0", "--port", "8002", "--loop", "uvloop"]
