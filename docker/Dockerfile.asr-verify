# Cross-verification ASR — faster-whisper large-v3 (CTranslate2)
# If the aarch64 CUDA build of CTranslate2 is broken, fall back to whisper.cpp
# with CUDA (§7): set asr_verify.backend: whisper_cpp and supply WHISPER_CPP_URL.
ARG BASE_IMAGE=dustynv/faster-whisper:r36.4.0
FROM ${BASE_IMAGE}

COPY --from=ghcr.io/astral-sh/uv:0.12 /uv /uvx /bin/

ENV UV_SYSTEM_PYTHON=1 \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY pyproject.toml uv.lock README.md LICENSE ./
RUN uv export --frozen --no-dev --no-emit-project --no-hashes -o /tmp/req.txt \
 && uv pip install --no-cache -r /tmp/req.txt

COPY src ./src
RUN uv pip install --no-cache --no-deps -e .

# Use the base image's aarch64 CUDA build of CTranslate2 as-is. Pulling it from
# PyPI again could swap in a CPU build, so only check that it is present.
RUN python3 -c "import ctranslate2, faster_whisper; print('ct2', ctranslate2.__version__, '| fw', faster_whisper.__version__)"

EXPOSE 8002
CMD ["uvicorn", "kotonoha.services.asr_verify_server:app", "--host", "0.0.0.0", "--port", "8002"]
