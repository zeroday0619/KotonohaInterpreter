# Cross-verification ASR — faster-whisper large-v3 (CTranslate2).
# The selected Tegra base targets CUDA 12.6 and sm_87. If CTranslate2 cannot
# use that runtime, fall back to whisper.cpp and supply WHISPER_CPP_URL.
ARG BASE_IMAGE=ghcr.io/nvidia-ai-iot/vllm:r36.4.tegra-aarch64-cu126-22.04
FROM ${BASE_IMAGE}
ENTRYPOINT []

COPY --from=ghcr.io/astral-sh/uv:0.12 /uv /uvx /bin/

ENV UV_SYSTEM_PYTHON=1 \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY pyproject.toml uv.lock README.md LICENSE hatch_build.py ./
RUN uv export --frozen --no-dev --no-emit-project --no-hashes -o /tmp/req.txt \
 && uv pip install --no-cache -r /tmp/req.txt

COPY src ./src
RUN uv pip install --no-cache --no-deps -e . \
 && uv pip install --no-cache soundfile faster-whisper

# PyPI publishes AArch64 wheels, but target execution still determines whether
# the wheel can load its GPU libraries under the selected CUDA 12.6 runtime.
RUN python3 -c "import ctranslate2, faster_whisper; print('ct2', ctranslate2.__version__, '| fw', faster_whisper.__version__)"

EXPOSE 8002
CMD ["uvicorn", "kotonoha.services._asr_verify_server:app", "--host", "0.0.0.0", "--port", "8002", "--loop", "uvloop"]
