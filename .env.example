# Copy this file to .env. Do not commit the resulting file.

# Application configuration
KOTONOHA_CONFIG=config/default.yaml
KOTONOHA_LOCAL_CONFIG=config/local.yaml
KOTONOHA_LANG=auto

# Deployment target and Web listener
KOTONOHA_EQUIPMENT=
KOTONOHA_WEB_HOST=127.0.0.1
KOTONOHA_WEB_PORT=8080
KOTONOHA_WEB_SESSIONS=4

# Shared service authentication. Generate at least 32 random characters.
KOTONOHA_SERVICE_TOKEN=

# Model storage and accelerator profile
MODELS_DIR=../models
ACCELERATOR_PROFILE=
CONTAINER_RUNTIME=nvidia
GPU_DRIVER=nvidia

# A6000 GPU assignment. scripts/deploy.sh can replace these values by UUID.
ASR_GPU_DEVICE=0
ASR_VERIFY_GPU_DEVICE=0
LLM_GPU_DEVICE=0
TTS_GPU_DEVICE=0

# Offline model policy. Set to 1 after every model snapshot has been staged.
TRANSFORMERS_OFFLINE=1

# Web configuration paths inside the container. The A6000 overlay replaces these.
KOTONOHA_WEB_CONFIG=/app/config/default.yaml
KOTONOHA_WEB_LOCAL_CONFIG=/app/config/local.yaml

# Translation service limits
LLM_MAX_MODEL_LEN=2048
LLM_MAX_NUM_BATCHED_TOKENS=4096
LLM_GPU_MEMORY_UTILIZATION=0.90
LLM_ENABLE_PREFIX_CACHING=1
LLM_COMPILATION_MODE=2

# Speech service limits
TTS_GPU_MEMORY_UTILIZATION=0.25
TTS_ENFORCE_EAGER=1

# Metrics
PROMETHEUS_PORT=9091
