#: kotonoha/_cli.py:804
#, python-format
msgid "  ! The link consumes more than 25% of the budget. Consider hybrid mode."
msgstr "  ! 링크가 예산의 25%를 넘게 소모한다. hybrid 모드를 검토할 것."

#: kotonoha/_cli.py:806
msgid "  The link fits within the budget. The remainder is model inference time."
msgstr "  링크는 예산 안에 든다. 남은 것은 모델 추론 시간이다."

